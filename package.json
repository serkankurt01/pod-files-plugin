{
  "name": "pod-files-plugin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:dev": "webpack --config webpack.config.js --mode=development",
    "start": "webpack serve --config webpack.config.js --hot"
  },
  "consolePlugin": {
    "name": "pod-files-plugin",
    "version": "1.0.0",
    "displayName": "Pod Files Plugin",
    "description": "Browse, edit, download and upload files inside pod containers from the OpenShift Console",
    "exposedModules": {
      "FilesTab": "./components/FilesTab"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  },
  "dependencies": {
    "@openshift-console/dynamic-plugin-sdk": "^1.3.0",
    "@patternfly/react-core": "^4.0.0",
    "@patternfly/react-icons": "^4.0.0",
    "@patternfly/react-table": "^4.0.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "overrides": {
    "ajv": "^8.0.0"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.3.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
